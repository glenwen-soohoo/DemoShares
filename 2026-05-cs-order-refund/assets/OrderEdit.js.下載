function pause(id, states) {
  var str = "確認暫停此筆?";
  if (states == "returned") {
    str = "確認退貨此筆?";
  }
  if (confirm(str)) {
    $.ajax({
      async: true,
      url: "/webapi/PauseOrderShippingTimeFromAdmin",
      type: "POST",
      data: { Id: id, States: states },
      beforeSend: function () {
        $.blockUI({ message: "處理中，請稍候.." });
      },
      complete: function () {
        //$.unblockUI();
      },
      success: function (data) {
        if (data > 0) {
          location.reload();
        } else {
          $.unblockUI();
          alert("發生錯誤!");
        }
      },
      error: function () {
        $.unblockUI();
        alert("發生錯誤，請檢查網路連線狀態");
      },
    });
  }
}

