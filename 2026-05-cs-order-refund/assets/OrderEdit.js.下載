//確認是否已有檢或單或黑貓單號
function checkBlackCatNum(ordersId) {
  $.ajax({
    async: false,
    url: "/gox/Orders/checkBlackCatNumAndPackFile",
    type: "POST",
    dataType: "json",
    data: {
      ordersId: ordersId,
    },

    success: function (data) {
      // .NET 9 migration: server 端 `public bool` action 在 ASP.NET Core 下
      // 序列化成 JSON 小寫 true/false，不再是 .NET Framework 的純文字 "True"/"False"。
      // 明確用 dataType:"json" 讓 jQuery parse 成 JS boolean，再以 === true 比對。
      if (data === true) {
        if (confirm("此筆訂單已經有檢貨單或黑貓單號，確定修改?")) {
          check();
        } else {
          return false;
        }
      } else {
        check();
      }
    },
    error: function () {
      $.unblockUI();
      alert("連線錯誤，無法確認是否已有檢貨單或黑貓單號");

      return;
    },
  });
}

function check() {
  if ($("#form").valid()) {
    if (!$("#totalPriceIsZero")) {
      let Valid = 0;
      if (
        $("[name=InvoiceType]").val() == "三聯式" &&
        $("#CompanyName").val() == ""
      ) {
        $("#CompanyNameValid").css("display", "block");
        $("html, body").scrollTop($("#CompanyNameValid").offset().top - 200);
        Valid++;
      }
      if (
        $("[name=InvoiceType]").val() == "三聯式" &&
        $("#TaxId").val() == ""
      ) {
        $("#TaxIdValid").css("display", "block");
        $("html, body").scrollTop($("#TaxIdValid").offset().top - 200);
        Valid++;
      }

      if (
        $("[name=InvoiceNumber]").val() == "" &&
        $("[name=InvoiceTime]").val() != ""
      ) {
        $("#InvoiceNumberValid").css("display", "block");
        $("html, body").scrollTop($("#InvoiceNumberValid").offset().top - 200);
        Valid++;
      }

      if (Valid > 0) {
        return false;
      }
    }

    ordersEdit_form.submit(); //submit

    $.blockUI({ message: "處理中，請稍候.." });
    return true;
  } else {
    var validator = $("#form").validate();
    var invalidElements = validator.invalidElements();
    var getPrecedingLabel = function (el) {
      // 向前找同層（或 wrapping <label>）的 text node，取第一個有中文/文字內容的
      var node = el.previousSibling;
      var guard = 0;
      while (guard++ < 30) {
        while (node) {
          if (node.nodeType === 3) {
            var t = $.trim(node.nodeValue);
            if (t) return t;
          } else if (node.nodeType === 1) {
            var tagName = (node.tagName || "").toLowerCase();
            if (tagName === "br" || tagName === "span" || tagName === "a") {
              // 跳過這類 inline 元素
            } else {
              var tt = $.trim($(node).text());
              if (tt && tt.length < 30) return tt;
            }
          }
          node = node.previousSibling;
        }
        // 爬到容器邊界，往上一層繼續找（限制不跨 td / .editor-field）
        var parent = el.parentNode;
        if (!parent) break;
        var pTag = (parent.tagName || "").toLowerCase();
        if (pTag === "td" || pTag === "form" || pTag === "body") break;
        el = parent;
        node = el.previousSibling;
      }
      return "";
    };

    var fieldLabels = $.map(invalidElements, function (el) {
      var label =
        $.trim($("label[for='" + el.id + "']").text()) ||
        $.trim(
          $(el).closest(".editor-field").prev(".editor-label").text()
        ) ||
        getPrecedingLabel(el) ||
        "未命名欄位";
      label = label.replace(/^\*\s*/, "").replace(/[:：]\s*$/, "").replace(/\s+/g, " ");
      return "<li>" + label + "</li>";
    });

    $("<div></div>")
      .html(
        "<p>以下欄位驗證失敗，請確認填寫內容：</p><ul>" +
          fieldLabels.join("") +
          "</ul>"
      )
      .dialog({
        title: "提示",
        modal: true,
        width: 400,
        resizable: false,
        buttons: {
          確定: function () {
            $(this).dialog("close");
          },
        },
        close: function () {
          $(this).remove();
          if (invalidElements.length > 0) {
            var $first = $(invalidElements[0]);
            $("html, body").animate(
              { scrollTop: $first.offset().top - 150 },
              400
            );
            $first.focus();
          }
        },
      });

    return false;
  }
}

