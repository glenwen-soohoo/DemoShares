function lineAD(trackType, productCategory, needMatchKey) {
    try {
        if (needMatchKey) {
            var category = lineCategoryMatch[trackType];

            if (category) {
                var categoryName = Object.keys(category).find(function (e) {
                    return productCategory.includes(e);
